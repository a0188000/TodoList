{
  "server": {
    "host": "127.0.0.1",
    "port": 4000
  },
  "tracker": {
    "kind": "jira",
    "active_states": [
      "待辦事項",
      "SA/SD",
      "In Development",
      "Code Review",
      "Rework"
    ],
    "terminal_states": [
      "完成",
      "Waiting For QA"
    ],
    "recheck_states": [
      "Code Review"
    ],
    "recheck_interval_ms": 300000
  },
  "polling": {
    "enabled": true,
    "interval_ms": 30000
  },
  "repo": {
    "base_branch": "develop",
    "remote": "origin"
  },
  "workspace": {
    "root": "~/code/ai-demo-workspaces"
  },
  "hooks": {
    "after_create": "git -C \"$REPO_ROOT\" fetch \"$REMOTE\" --quiet || true\ngit -C \"$REPO_ROOT\" worktree add --detach \"$WORKSPACE\" \"$REMOTE/$BASE_BRANCH\" 2>/dev/null || git -C \"$REPO_ROOT\" worktree add --detach \"$WORKSPACE\" \"$BASE_BRANCH\"",
    "before_remove": "git -C \"$REPO_ROOT\" worktree remove --force \"$WORKSPACE\""
  },
  "agent": {
    "model": "claude-opus-5-5",
    "handoff_model": "claude-haiku-4-5",
    "max_concurrent_agents": 1,
    "max_turns": 200,
    "max_continuations": 2,
    "stall_timeout_ms": 900000
  },
  "claude_code": {
    "command": "claude",
    "permission_args": [
      "--permission-mode",
      "acceptEdits"
    ],
    "extra_args": []
  },
  "env": {
    "DEVELOPER_DIR": "/Applications/Xcode-26.2.0.app/Contents/Developer"
  }
}
